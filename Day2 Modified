<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invitation Card</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Arial', sans-serif;
            background: linear-gradient(135deg, #000000 0%, #764ba2 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .invitation-card {
            background: linear-gradient(135deg, #fff5e6 0%, #ffe4cc 100%);
            border-radius: 20px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
            max-width: 600px;
            width: 100%;
            overflow: hidden;
            animation: slideIn 0.8s ease-out;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .card-header {
            background: linear-gradient(135deg, #585d75 0%, #764ba2 100%);
            color: white;
            padding: 30px;
            text-align: center;
        }

        .card-header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
        }

        .card-header p {
            font-size: 1.1em;
            opacity: 0.9;
        }

        .card-content {
            padding: 30px;
        }

        .invitation-text {
            text-align: center;
            margin-bottom: 30px;
            line-height: 1.8;
            color: #333;
        }

        .invitation-text h2 {
            color: #667eea;
            margin-bottom: 15px;
            font-size: 1.8em;
        }

        .invitation-text p {
            font-size: 1.1em;
            margin: 10px 0;
        }

        .event-details {
            background: rgba(102, 126, 234, 0.1);
            border-left: 4px solid #667eea;
            padding: 15px;
            margin: 20px 0;
            border-radius: 5px;
        }

        .event-details p {
            margin: 8px 0;
            color: #555;
        }

        .event-details strong {
            color: #667eea;
        }

        /* Audio Section */
        .media-section {
            margin: 25px 0;
        }

        .media-section h3 {
            color: #667eea;
            margin-bottom: 12px;
            font-size: 1.2em;
        }

        audio, video, iframe {
            width: 100%;
            border-radius: 10px;
            margin-bottom: 15px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }

        audio {
            height: 40px;
            cursor: pointer;
        }

        video {
            height: 300px;
            background: #000;
        }

        iframe {
            height: 300px;
            border: none;
        }

        .media-label {
            font-size: 0.9em;
            color: #666;
            margin-top: -10px;
            margin-bottom: 10px;
            font-style: italic;
        }

        .button-section {
            text-align: center;
            margin-top: 25px;
        }

        .rsvp-button {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            padding: 12px 30px;
            font-size: 1em;
            border-radius: 25px;
            cursor: pointer;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

        .rsvp-button:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(102, 126, 234, 0.6);
        }

        .footer {
            text-align: center;
            padding: 20px;
            background: rgba(0, 0, 0, 0.02);
            color: #999;
            font-size: 0.9em;
            border-top: 1px solid rgba(0, 0, 0, 0.1);
        }

        @media (max-width: 600px) {
            .card-header h1 {
                font-size: 2em;
            }

            .invitation-text h2 {
                font-size: 1.5em;
            }

            video {
                height: 200px;
            }

            iframe {
                height: 250px;
            }
        }
    </style>
</head>
<body>
    <div class="invitation-card">
        <!-- Header -->
        <div class="card-header">
            <h1> You're Invited! </h1>
            <p>Join us for a memorable celebration</p>
        </div>

        <!-- Content -->
        <div class="card-content">
            <!-- Invitation Text -->
            <div class="invitation-text">
                <h2>An Evening of Celebration</h2>
                <p>We are delighted to invite you to celebrate with us!</p>
            </div>

            <!-- Event Details -->
            <div class="event-details">
                <p><strong> Date:</strong> June 15, 2026</p>
                <p><strong> Time:</strong> 6:00 PM - 10:00 PM</p>
                <p><strong> Location:</strong> Grand Ballroom, City Center</p>
                <p><strong> Dress Code:</strong> Formal Attire</p>
            </div>

            <!-- Audio Section -->
            <div class="media-section">
                <h3> Background Music</h3>
                <audio controls>
                    <source src="https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3" type="audio/mpeg">
                    Your browser does not support the audio element.
                </audio>
            </div>

            <!-- Video Section -->
            <div class="media-section">
                <h3>Event Preview Video</h3>
                <video controls poster="https://via.placeholder.com/600x300?text=Event+Preview">
                    <source src="https://www.w3schools.com/html/mov_bbb.mp4" type="video/mp4">
                    Your browser does not support the video element.
                </video>
            </div>

            <!-- Iframe Section (Embedded Map) -->
            <div class="media-section">
                <h3> Event Location</h3>
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3024.1234567890!2d-74.0060!3d40.7128!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c25a31a0e1b1b1%3A0x1234567890abcdef!2sNew%20York%2C%20NY!5e0!3m2!1sen!2sus!4v1234567890" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>

            <!-- RSVP Button -->
            <div class="button-section">
                <button class="rsvp-button" onclick="alert('Thank you for your RSVP! See you at the event.')">Click Here to Join</button>
            </div>
        </div>

        <!-- Footer -->
        <div class="footer">
            <p>We look forward to celebrating with you! For more information, contact: info@event.com</p>
        </div>
    </div>
</body>
</html>
