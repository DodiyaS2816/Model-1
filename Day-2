  <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Student Registration Form</title>
        <style>
       form{
        background-color: rgb(234, 135, 105);
        width: 50%;
        margin: auto;
        padding: 20px;
        }
        body{
            background-color: rgb(243, 252, 255);
        }
        header{
            background-color: rgb(188, 178, 178);
            color: white;
            text-align: center;
            padding: 20px;
            border-radius: 10px;
        }
        form{
            background-color: rgb(253, 253, 253);
            width: 500px;
            height: 100%;
            margin: auto;
            padding: 20px;
            border-radius: 10px;
            text-align:left;
            margin-bottom: 20px;
            margin-top: 20px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
            h1{
                color: #bf5454;
                font-size: 24px;
                margin-bottom: 20px;
                width: 100%;
                text-align: center;
                text-decoration-line: underline;
            }
        }
        footer{
            background-color: rgb(172, 163, 163);
            color: white;
            text-align: center;
            padding: 10px;
            margin-top: 20px;
            border-radius: 10px;
        }
        nav{
            background-color: rgb(100, 100, 100);
            padding: 10px;
            text-align: center;
            border-radius: 10px;
        }
        nav a{
            color: white;
            text-decoration: none;
            margin: 0 15px;
        }
        nav a:hover{
            text-decoration: underline;
        }
        button{
            background-color: rgb(169, 161, 249);
            color: white;
            border: none;
            padding: 10px;
            cursor: pointer;
            border-radius: 15px;
            height: 40px;
            width: 500px;
        }
        aside{
            background-color: rgb(253, 253, 253);
            width: 300px;
            padding: 20px;
            border-radius: 10px;
            margin-top: 20px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            text-align: left;
        }
        </style>
    </head>
    <body>
  <header>
    <h1>Silver oak University</h1>
  </header>
  <nav>
    <a href="#home">Home</a>
    <a href="#about">About</a>
    <a href="#contact">Contact</a>
    <a href="#help">Help</a>
  </nav>
  <form action="Student Registrtion Form">
    <main>
      <section>
          <h1>Student Registration Form</h1>
            Name: <input type="text" id="Name" placeholder="Enter Name" required><br><br>
            Enrollment: <input type="text" id="Enrollment no" placeholder="Enter Enrollment" required><br><br>
            Branch:<select name="Branch" id="Branch" aria-placeholder="Select Branch" required><br><br>
            <option value="select">Select</option>
            <option value="Cse">CSE</option>
            <option value="IT">IT</option>
            <option value="Ce">Ce</option>
            </select><br><br>
            Division: <input type="text" id="Division" placeholder="Enter Division" maxlength="1" required><br><br>
            Gender: <input type="radio" id="Male" name="Gender" value="Male" required>Male
            <input type="radio" id="Female" name="Gender" value="Female" required>Female<br><br>
            Mobile No: <input type="number" id="number" placeholder="Enter Number" required><br><br>
            Email Id: <input type="email" id="Email" placeholder="Enter Email" required><br><br>
            Password : <input type="password" id="Password" placeholder="Enter Password" required><br><br>
            Photo Upload : <input type="file" id="Photo upload"><br><br>
          Remarks: <textarea id="Remarks" placeholder="Enter Remarks" rows="4" cols="50"></textarea><br><br>
            <button>Submit
            </button>
        </section>
        <aside>
          <h3>Registration Tips</h3>
          <ul>
            <li>Use valid enrollment number</li>
            <li>Password must be strong</li>
            <li>Upload a clear photo</li>
            <li>Verify all details before submit</li>
          </ul>
        </aside>
    </main>
        </form>
          <footer>
            <p>--Made by Shubham--</p> 
        </footer>
        </body>
        </html>
       
